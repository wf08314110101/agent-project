# ---- 控制面（server，部署在服务器） ----
PORT=8787
DATABASE_URL=postgres://rag:rag123@localhost:5432/bugfix
AGENT_TOKEN=change-me-long-random
ATTACHMENT_DIR=./data/attachments
MAX_UPLOAD_MB=10
LEASE_SEC=900          # 领单租约，超时未上报自动回收
MAX_ATTEMPTS=3         # 批次最多重试次数

# ---- 执行面（agent，运行在本地仓库所在机器） ----
SERVER_URL=http://localhost:8787
POLL_INTERVAL_SEC=30
BUG_TIMEOUT_SEC=900    # 单 BUG aider 修复超时
TEST_TIMEOUT_SEC=600   # 批次回归测试超时
MAIN_REPO_ROOT=/Volumes/document/work/agent-学习
WORKTREE_ROOT=./worktrees
MERGE_RETRYABLE=true

# ---- LLM（aider 修复 + 截图 vision 转述，OpenAI 兼容端点） ----
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxx
AIDER_MODEL=openai/deepseek-chat
AIDER_EDIT_FORMAT=diff   # aider 编辑格式：diff（搜索/替换块）对 deepseek 更稳
VISION_MODEL=deepseek-flash   # 留空则跳过截图转述
