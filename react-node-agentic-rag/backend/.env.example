PORT=8788
CORS_ORIGIN=true

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agentic_docs
# Postgres 连接串（文档元数据/会话/消息；docker-compose 里有同名 postgres 服务）
DATABASE_URL=postgres://rag:rag123@localhost:5432/rag
# M12 多实例共享态：非空启用 Redis（限流计数共享 + 摄取事件 pub/sub 广播）；留空=进程内存（单实例够用）
REDIS_URL=redis://localhost:6379

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-chat

EMBED_MODEL=Xenova/bge-small-zh-v1.5
EMBED_DIM=512
EMBED_DEVICE=cpu
HF_ENDPOINT=https://hf-mirror.com

RETRIEVE_MIN_SCORE=0.3

AGENT_MAX_ITERATIONS=6
SEARCH_MAX_ATTEMPTS=2

RATE_LIMIT_MAX=120
CHAT_RATE_LIMIT_MAX=20
FALLBACK_DIRECT=true
UPLOADS_DIR=./data/uploads

# Langfuse（经 OTLP 摄入）：三项齐全即启用，一次埋点自动导出
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx

# Phoenix（OTLP 导出）：true 启用，与 Langfuse 并行双导出
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

UPLOAD_MAX_MB=20

# ---- M5 鉴权（预置用户 + JWT，无开放注册）----
# JWT 签名密钥：生产必须改成随机长串（openssl rand -hex 32）
JWT_SECRET=请改成随机长字符串
# M14 无状态鉴权：access 短效期（authenticate 不查库，权限变更靠 token_ver 即刻失效）
JWT_ACCESS_TTL=15m
# refresh token 有效期（天）；单活模型，登录/刷新旋转覆盖
JWT_REFRESH_DAYS=30
# 预置用户：启动时播种进 users 表（密码 scrypt 哈希存储）；已存在用户不覆盖
AUTH_USERS=demo:demo123,alice:alice123
# 会话回放窗口条数（更早消息滚动摘要压缩）
MEMORY_WINDOW=20

# ---- M17 领域包（可插拔垂直场景；留空 = 纯 core 行为，零破坏面）----
# 启用的领域包（逗号分隔；当前可选 api-docs）。启用后：主检索集合切到 rag_api_docs、
# 标签词表/切分策略/提示片段由领域包注入、/api/documents 上传接受 collection=rag_api_docs
DOMAIN_PACKS=
# 连接器定时同步间隔（分钟）；0 = 不定时，仅手动 npm run domain:sync
DOMAIN_SYNC_INTERVAL_MIN=0
# 同步源（GitHub md 仓库），默认 Vue 官方中文文档
DOMAIN_SYNC_REPO=vuejs-translations/docs-zh-cn
DOMAIN_SYNC_BRANCH=main
DOMAIN_SYNC_DIR=src/
DOMAIN_SYNC_DEPRECATED_DIR=
# 单次同步最多摄取文件数（防跑飞）
DOMAIN_SYNC_MAX_FILES=40
# GitHub API Token（可选，防匿名 60 次/h 限流）
GITHUB_TOKEN=
