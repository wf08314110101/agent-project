# 复制为 .env 并按需修改（后端在 backend 目录启动，能读到当前目录 .env 由 shell 注入）
# 若已配置全局环境变量可跳过；未命令行注入时后端读到的是 config.py 的默认值。

# 必填：DeepSeek 的 API Key（OpenAI 兼容）
RAG_LLM_API_KEY=sk-xxxxxxxxxxxx

# 可选：切换 embedding 模型
# RAG_EMBEDDING_MODEL=BAAI/bge-m3
# RAG_EMBEDDING_DEVICE=cpu

# 可选：向量库持久化目录 / 分块 / 检索参数
# RAG_PERSIST_DIR=./data/chroma
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=80
# RAG_TOP_K=4

# 可选：OCR（扫描版 PDF 回退识别）
# RAG_OCR_ENABLED=true
# RAG_OCR_LANG=chi_sim+eng