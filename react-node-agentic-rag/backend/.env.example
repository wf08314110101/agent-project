PORT=8788
CORS_ORIGIN=true

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agentic_docs
# Postgres 连接串（文档元数据/会话/消息；docker-compose 里有同名 postgres 服务）
DATABASE_URL=postgres://rag:rag123@localhost:5432/rag
# M12 多实例共享态：非空启用 Redis（限流计数共享 + 摄取事件 pub/sub 广播）；留空=进程内存（单实例够用）
REDIS_URL=redis://localhost:6379

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-chat

# 嵌入 provider：local = 本地 CPU transformers.js（默认）；openai = OpenAI 兼容 /embeddings（换 provider 时 EMBED_DIM 必须同步改，集合维度建后不可改）
EMBED_PROVIDER=local
EMBED_MODEL=Xenova/bge-small-zh-v1.5
EMBED_DIM=512
EMBED_DEVICE=cpu
HF_ENDPOINT=https://hf-mirror.com
# provider=openai 时必填（如 BAAI/bge-m3）；BASE_URL/KEY 留空 = 复用 LLM_*
EMBED_API_MODEL=
EMBED_API_BASE_URL=
EMBED_API_KEY=

RETRIEVE_MIN_SCORE=0.3
# M8 融合算法：rrf（排名融合，默认）| dbsf（绝对分融合）；召回池倍率，0 = 默认 max(k*3, 12)
RETRIEVE_FUSION=rrf
RETRIEVE_PREFETCH_MUL=0
# M9 cross-encoder 精排（本地 ONNX）：dtype q8 体积小速度快，fp32 更准
RERANK_MODEL=Xenova/bge-reranker-base
RERANK_DTYPE=q8
# M15 Qdrant 建集合调优（存量集合需删除重建才生效）：量化分位 0=关 / HNSW 参数
QDRANT_QUANTILE=0.99
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=128
QDRANT_HNSW_EF=0
# M15 回答缓存 TTL 秒（键=问题+ACL指纹+KB纪元）；0 = 关闭
ANSWER_CACHE_TTL_SEC=1800
# M15 首跳检索前 LLM 改写/关键词化（增 ~1s 延迟）
QUERY_REWRITE=false

AGENT_MAX_ITERATIONS=6
SEARCH_MAX_ATTEMPTS=2

RATE_LIMIT_MAX=120
CHAT_RATE_LIMIT_MAX=20
FALLBACK_DIRECT=true
UPLOADS_DIR=./data/uploads

# ---- 网络搜索兜底（CRAG：库内不足时联网补救）----
# provider：bing（免 key 抓取，默认）| tavily（需 key）| off（关闭兜底）
WEB_SEARCH_PROVIDER=bing
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_TIMEOUT_MS=8000

# ---- M13 MCP Server（知识库服务化，工具只读）----
MCP_ENABLED=true
# 服务身份用户名（须在 AUTH_USERS 里）；留空 = 仅 public 匿名可见面
MCP_ACCESS_USER=
# 非空才挂 POST /mcp（Streamable HTTP + Bearer）；stdio 入口不受限
MCP_HTTP_TOKEN=

# Langfuse（经 OTLP 摄入）：三项齐全即启用，一次埋点自动导出
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx

# Phoenix（OTLP 导出）：true 启用，与 Langfuse 并行双导出
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

UPLOAD_MAX_MB=20

# ---- M5 鉴权（预置用户 + JWT，无开放注册）----
# JWT 签名密钥：生产必须改成随机长串（openssl rand -hex 32）
JWT_SECRET=请改成随机长字符串
# M14 无状态鉴权：access 短效期（authenticate 不查库，权限变更靠 token_ver 即刻失效）
JWT_ACCESS_TTL=15m
# refresh token 有效期（天）；单活模型，登录/刷新旋转覆盖
JWT_REFRESH_DAYS=30
# 预置用户：启动时播种进 users 表（密码 scrypt 哈希存储）；已存在用户不覆盖
AUTH_USERS=demo:demo123,alice:alice123
# 会话回放窗口条数（更早消息滚动摘要压缩）
MEMORY_WINDOW=20

# ---- M17 领域包（可插拔垂直场景；留空 = 纯 core 行为，零破坏面）----
# 启用的领域包（逗号分隔；当前可选 api-docs）。启用后：主检索集合切到 rag_api_docs、
# 标签词表/切分策略/提示片段由领域包注入、/api/documents 上传接受 collection=rag_api_docs
DOMAIN_PACKS=
# 连接器定时同步间隔（分钟）；0 = 不定时，仅手动 npm run domain:sync
DOMAIN_SYNC_INTERVAL_MIN=0
# 同步源（GitHub md 仓库），默认 Vue 官方中文文档
DOMAIN_SYNC_REPO=vuejs-translations/docs-zh-cn
DOMAIN_SYNC_BRANCH=main
DOMAIN_SYNC_DIR=src/
DOMAIN_SYNC_DEPRECATED_DIR=
# 单次同步最多摄取文件数（防跑飞）
DOMAIN_SYNC_MAX_FILES=40
# GitHub API Token（可选，防匿名 60 次/h 限流）
GITHUB_TOKEN=

# ---- M18 语料时效治理 ----
# 版本化替换开关：off=不替换（同 docKey 新旧共存）| on=全集合替换 | auto=core 关、领域集合开（默认）
DOC_REPLACE_MODE=auto
# deprecated 文档命中融合分乘数（0.3 = 降权为三成；1 = 不降权；降权非硬滤，明确问旧版仍可召回）
DEPRECATED_PENALTY=0.3

# ---- M19 OCR（视觉大模型转录：扫描件 PDF / 图片 / docx 内嵌图）----
# DeepSeek 无视觉模型，OCR 需另配 provider；OCR_MODEL 留空 = 关闭
# （扫描件仅取文本层、图片/docx 图跳过，不阻断摄取）
# 常用视觉模型：Qwen/Qwen2.5-VL-72B-Instruct（硅基流动）、glm-4.5v（智谱）、
#               doubao-1.5-vision-pro（火山）、gpt-4o-mini（OpenAI）
OCR_PROVIDER=vlm
OCR_MODEL=
# 视觉模型端点/密钥（视觉模型常与对话模型不同 provider）；留空 = 复用 LLM_BASE_URL / LLM_API_KEY
OCR_BASE_URL=
OCR_API_KEY=
# 成本闸：单文档扫描页/内嵌图转录上限，超出截断并标注
OCR_MAX_PAGES=30
OCR_MAX_IMAGES=20
